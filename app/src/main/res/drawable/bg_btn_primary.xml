<?xml version="1.0" encoding="utf-8"?>
<!--
    主操作按钮背景(蓝填充):无描边 + 16dp 圆角
    用途:主界面"开始录制"按钮、相机快门、保存剪辑等主操作
    按下态走 state_pressed 叠加深蓝
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue_dark" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_hint" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
