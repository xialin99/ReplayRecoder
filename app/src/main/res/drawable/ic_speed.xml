<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 速度表(仪表盘):上半圆弧线 + 斜指针 + 圆心。
         直观表示"播放速度/倍速",替代原来的齿轮图标。 -->
    <!-- 上半圆弧线(外圈刻度) -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M4,15 A8,8 0 0,1 20,15" />
    <!-- 左刻度 -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M5.5,13 L4.5,11" />
    <!-- 中刻度 -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,6 L12,4" />
    <!-- 右刻度 -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M18.5,13 L19.5,11" />
    <!-- 指针:从圆心(12,15)斜向右上 -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M12,15 L16.5,9" />
    <!-- 圆心 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,15 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />
</vector>
