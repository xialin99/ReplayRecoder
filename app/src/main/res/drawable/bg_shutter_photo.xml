<?xml version="1.0" encoding="utf-8"?>
<!-- 快门按钮 - 拍照态:白色实心圆 + 蓝色描边 4dp 外环,80dp。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外环:蓝色描边 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="4dp" android:color="@color/brand_blue" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
    <!-- 内圆:白色实心,留出 4dp 外环 -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
            <size android:width="72dp" android:height="72dp" />
        </shape>
    </item>
</layer-list>
