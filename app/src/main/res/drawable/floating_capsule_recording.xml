<?xml version="1.0" encoding="utf-8"?>
<!--
    悬浮胶囊录制态(DS 阶段3)
    80x36dp 胶囊形,绿色(符合硬约束:录制中=绿色),中心白色圆角方块(停止符号提示)
    配合 floating_pulse 动画,看一眼就知道在录、且知道怎么停。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈半透明描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/success_green" />
            <stroke android:width="2dp" android:color="#40FFFFFF" />
            <corners android:radius="18dp" />
            <size android:width="80dp" android:height="36dp" />
        </shape>
    </item>
    <!-- 绿色径向渐变 -->
    <item
        android:left="2dp" android:top="2dp"
        android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="32dp"
                android:centerX="38%"
                android:centerY="35%"
                android:startColor="#A5D6A7"
                android:centerColor="#43A047"
                android:endColor="#1B5E20" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
