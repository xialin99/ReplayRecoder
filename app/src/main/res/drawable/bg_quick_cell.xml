<?xml version="1.0" encoding="utf-8"?>
<!--
    三宫格快捷入口 cell 背景:白底 + 1px 描边 + 16dp 圆角
    按下态走浅蓝高亮
    用途:主界面三宫格 回放/相册/设置
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue_light" />
            <stroke
                android:width="@dimen/stroke_normal"
                android:color="@color/brand_blue" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke
                android:width="@dimen/stroke_normal"
                android:color="@color/stroke" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
</selector>
